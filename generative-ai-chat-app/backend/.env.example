# Copy this file to ".env" (same folder) and fill in your values.
# ".env" is git-ignored, never commit it.

# Azure OpenAI endpoint from the Foundry project home page (NOT the project endpoint).
# Expected shape: https://<your-resource>.openai.azure.com/openai/v1/
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/openai/v1/

# Exact name of your model deployment in Foundry
MODEL_DEPLOYMENT=gpt-5.2

# Authentication - choose ONE:
#  1) API key (no Azure CLI needed): paste the key from the Foundry portal.
#  2) Leave it empty/unset to use Entra ID sign-in instead (requires "az login").
AZURE_OPENAI_API_KEY=

# Optional: system prompt sent with every message
# SYSTEM_PROMPT=You are a helpful AI assistant that answers questions and provides information.

# Optional: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO
